//operator overloading
#include<iostream>

using namespace std;

class Complex{
    int real;
    int img;
    
    public:
    Complex(){
        
    }
    
    public:
    Complex(int real,int img){
        this->real = real;
        this->img = img;
    }
    //      c1+c2
    Complex operator + (Complex &c)//pass by reference//
    {
        Complex ans;
        ans.real = real+c.real;
        ans.img =  img +c.img;
        return ans;
    }
    
    void display(){
        cout<<real<<"+i"<<img<<endl;
    }
};

int main(){
    Complex c1(3,2);
    c1.display();
    Complex c2(4,5);
    c2.display();
    
                //calling object
    Complex c3 = c1+c2;
    c3.display();
    
    return 0;
}
