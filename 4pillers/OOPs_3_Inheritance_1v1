//1v1 Inheritance
class Human{
    //properties
    protected:
    string name;
    
};
//child class : parent class
class Student:public Human{
    int roll_no;
    
    public:
    Student(string n,int a){
        name = n;
        roll_no = a;
    }
    void display(){
        cout<<name<<" "<<roll_no<<endl;
    }
};

int main(){
    Student obj("Himanshu", 1146);
    obj.display();
}
